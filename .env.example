# Telegram MTProto Credentials
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=kotak_trader_session
TELEGRAM_CHANNELS=@your_signals_channel

# Google Gemini Parser
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.1
GEMINI_TIMEOUT_SECONDS=30
MESSAGE_HISTORY_CONTEXT_SIZE=5

# Google Cloud Pub/Sub (Always Free Tier - 10 GB/month included free)
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC_SIGNALS=kotak_trading_signals
# Optional: Path to Service Account JSON key (leave empty if using ADC or GCP VM IAM role)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Optional local emulator for offline testing:
# PUBSUB_EMULATOR_HOST=localhost:8085
