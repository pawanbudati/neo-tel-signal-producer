# Deployment Configuration for Producer
# Copy this file to .env.deploy in the producer directory (it is git-ignored):
# cp deploy/.env.deploy.example .env.deploy

GCP_VM_HOST=
GCP_VM_USER=
GCP_VM_SSH_KEY=~/.ssh/id_rsa
GCP_VM_SSH_PORT=22
PRODUCER_DEPLOY_PATH=

# Kafka Configuration
# If running Kafka locally via Docker on this VM, set its advertised host (internal IP or DNS):
KAFKA_ADVERTISED_HOST=
# Set to 'true' if Kafka is hosted externally (e.g., on OCI or dedicated VM):
SKIP_KAFKA=false
